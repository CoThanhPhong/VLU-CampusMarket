<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="16dp">

    <!-- 1. Thanh tìm kiếm thiết bị -->
    <EditText
        android:id="@+id/edtSearch"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Tìm theo tên thiết bị..."
        android:paddingHorizontal="16dp"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnFilterAll"
        android:layout_marginEnd="8dp"/>

    <!-- 2. Nhóm nút lọc nhanh (Tất cả, Điện thoại, Laptop...) -->
    <Button
        android:id="@+id/btnFilterAll"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Tất cả"
        android:backgroundTint="#2563EB"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 3. Tiêu đề danh sách bài đăng -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Danh sách bài đăng bán (54)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/edtSearch"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- 4. RecyclerView hiển thị danh sách sản phẩm dạng lưới (Grid) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewProducts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>