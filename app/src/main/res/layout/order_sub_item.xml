<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp"
    android:paddingHorizontal="4dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgSubProduct"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_placeholder_product"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
        app:strokeWidth="1dp"
        app:strokeColor="#E2E8F0" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvSubProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên sản phẩm thiết bị"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvSubProductDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SL: 1 | 350,000 đ | Cơ sở 1\n Người đăng: Cổ Thanh Phong"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>

</LinearLayout>
